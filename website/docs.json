                "group": "版本信息",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /version"
                ]
              },
              {
                "group": "缓存",
                "openapi": "api/openapi.json",
                "pages": [
                  "POST /cache/fakeip/flush",
                  "POST /cache/dns/flush"
                ]
              },
              {
                "group": "运行配置",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /configs",
                  "PUT /configs",
                  "PATCH /configs",
                  "POST /configs/geo",
                  "POST /restart"
                ]
              },
              {
                "group": "更新",
                "openapi": "api/openapi.json",
                "pages": [
                  "POST /upgrade",
                  "POST /upgrade/ui",
                  "POST /upgrade/geo"
                ]
              },
              {
                "group": "策略组",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /group",
                  "GET /group/{name}",
                  "GET /group/{name}/delay"
