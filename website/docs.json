{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "YumeBox",
  "colors": {
    "primary": "#cfcfff",
    "light": "#07C983",
    "dark": "#b3b7fa"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/images/favicon.",
  "navigation": {
    "languages": [
      {
        "language": "zh-Hans",
        "default": true,
        "tabs": [
          {
            "tab": "文档",
            "icon": "book-open",
            "groups": [
              {
                "group": "开始",
                "pages": [
                  "/index",
                  "/update/history"
                ]
              },
              {
                "group": "覆写",
                "icon": "file-code",
                "pages": [
                  "/override/yaml",
                  "/override/js-override"
                ]
              },
              {
                "group": "构建",
                "pages": [
                  "/guide/build",
                  "/guide/faq"
                ]
              }
            ]
          },
          {
            "tab": "API 参考",
            "icon": "square-terminal",
            "groups": [
              {
                "group": "日志",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /logs"
                ]
              },
              {
                "group": "流量信息",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /traffic"
                ]
