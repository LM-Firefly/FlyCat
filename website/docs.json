  "logo": {
    "light": "/images/logo.webp",
    "dark": "/images/logo.webp"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/YumeYucca/YumeBox/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Github",
      "href": "https://github.com/YumeYucca/YumeBox"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "grok",
      "aistudio"
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://yumebox.gal.tf",
      "og:image": "https://yumebox.gal.tf/images/og.webp"
    },
    "organization": {
      "id": "https://www.yumeyuka.moe/#person",
      "url": "https://www.yumeyuka.moe",
      "sameAs": [
        "https://github.com/YumeYuka",
        "https://gitcode.com/YumeYuka",
        "https://yumeyuka.plus.my.id/"
      ],
      "name": "YumeYuka"
    },
    "indexing": "all"
  },
  "metadata": {
    "timestamp": true
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    }
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/OOM_Group",
      "github": "https://github.com/YumeYuka"
    }
  },
  "fonts": {
    "heading": {
      "family": "Ubuntu Sans"
    }
  },
  "redirects": [
    {
      "source": "/guide/app",
      "destination": "/guide/faq"
    },
    {
      "source": "/guide/quickstart",
      "destination": "/guide/faq"
    },
    {
      "source": "/override/fields",
      "destination": "/override/yaml"
    },
    {
      "source": "/en/guide/app",
      "destination": "/en/guide/faq"
    },
    {
      "source": "/en/guide/quickstart",
      "destination": "/en/guide/faq"
    },
    {
      "source": "/en/override/fields",
      "destination": "/en/override/yaml"
    },
    {
      "source": "/override/override",
      "destination": "/override/yaml"
    },
    {
      "source": "/en/override/override",
      "destination": "/en/override/yaml"
    },
    {
      "source": "/override/js",
      "destination": "/override/js-override"
    },
    {
      "source": "/en/override/js",
      "destination": "/en/override/js-override"
    },
    {
      "source": "/override/javascript",
      "destination": "/override/js-override"
    },
    {
      "source": "/en/override/javascript",
      "destination": "/en/override/js-override"
    },
    {
      "source": "/override/intro",
      "destination": "/override/yaml"
    },
    {
      "source": "/en/override/intro",
      "destination": "/en/override/yaml"
    }
  ]
