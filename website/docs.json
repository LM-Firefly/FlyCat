                  "DELETE /storage/{key}"
                ]
              },
              {
                "group": "DEBUG",
                "openapi": "api/openapi.json",
                "pages": [
                  "PUT /debug/gc",
                  "GET /debug/pprof"
                ]
              }
            ]
          }
