                  "GET /providers/proxies/{name}/healthcheck",
                  "GET /providers/proxies/{providerName}/{name}",
                  "GET /providers/proxies/{providerName}/{name}/healthcheck"
                ]
              },
              {
                "group": "规则",
                "openapi": "api/openapi.json",
                "pages": [
                  "GET /rules",
                  "PATCH /rules/disable"
