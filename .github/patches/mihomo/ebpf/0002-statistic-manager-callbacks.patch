From: FlyCat local customization
Subject: [PATCH] tunnel/statistic: add event-driven traffic push callbacks (ebpf)

Add OnJoin/OnLeave/OnTrafficUpdate callbacks to Manager for real-time
traffic statistics push to the Android layer. Traffic updates ride the
existing wake/dormancy ticker: a push fires when traffic flowed or the
rate changed (including the drop to zero right before the ticker goes
dormant), so idle periods stay silent and power-lean.

Add InitialUpload/InitialDownload fields to TrackerInfo so consumers
can compute per-connection traffic deltas without maintaining external
baselines (B1 design: delta at source).
diff --git a/tunnel/statistic/manager.go b/tunnel/statistic/manager.go
index 7ac67ce51..fa2609aa2 100644
--- a/tunnel/statistic/manager.go
+++ b/tunnel/statistic/manager.go
@@ -29,30 +29,41 @@ func init() {
 }
 
 type Manager struct {
-	connections   xsync.Map[string, Tracker]
-	smartTarget   xsync.Map[string, *xsync.Map[string, bool]]
-	uploadTemp    atomic.Int64
-	downloadTemp  atomic.Int64
-	uploadBlip    atomic.Int64
-	downloadBlip  atomic.Int64
-	uploadTotal   atomic.Int64
-	downloadTotal atomic.Int64
-	pid           int32
-	memory        atomic.Uint64
-	memoryMu      sync.Mutex
-	memoryUpdated time.Time
-	trafficActive atomic.Bool
-	trafficWake   chan struct{}
+	connections         xsync.Map[string, Tracker]
+	smartTarget         xsync.Map[string, *xsync.Map[string, bool]]
+	uploadTemp          atomic.Int64
+	downloadTemp        atomic.Int64
+	uploadBlip          atomic.Int64
+	downloadBlip        atomic.Int64
+	uploadTotal         atomic.Int64
+	downloadTotal       atomic.Int64
+	pid                 int32
+	memory              atomic.Uint64
+	memoryMu            sync.Mutex
+	memoryUpdated       time.Time
+	trafficActive       atomic.Bool
+	trafficWake         chan struct{}
+	lastPushedUpSpeed   atomic.Int64
+	lastPushedDownSpeed atomic.Int64
+	OnJoin              func(*TrackerInfo)
+	OnLeave             func(*TrackerInfo)
+	OnTrafficUpdate     func(uploadTotal, downloadTotal, uploadSpeed, downloadSpeed int64)
 }
 
 func (m *Manager) Join(c Tracker) {
 	m.connections.Store(c.ID(), c)
 	m.joinSmartTarget(c)
+	if m.OnJoin != nil {
+		m.OnJoin(c.Info())
+	}
 }
 
 func (m *Manager) Leave(c Tracker) {
 	m.connections.Delete(c.ID())
 	m.leaveSmartTarget(c)
+	if m.OnLeave != nil {
+		m.OnLeave(c.Info())
+	}
 }
 
 func (m *Manager) Get(id string) (c Tracker) {
@@ -134,6 +145,8 @@ func (m *Manager) ResetStatistic() {
 	m.downloadTemp.Store(0)
 	m.downloadBlip.Store(0)
 	m.downloadTotal.Store(0)
+	m.lastPushedUpSpeed.Store(0)
+	m.lastPushedDownSpeed.Store(0)
 }
 
 func (m *Manager) wakeTraffic() {
@@ -163,6 +176,14 @@ func (m *Manager) handle(ctx context.Context, interval time.Duration) {
 			up, down := m.uploadTemp.Swap(0), m.downloadTemp.Swap(0)
 			m.uploadBlip.Store(up)
 			m.downloadBlip.Store(down)
+			if m.OnTrafficUpdate != nil {
+				if up != 0 || down != 0 ||
+					up != m.lastPushedUpSpeed.Load() || down != m.lastPushedDownSpeed.Load() {
+					m.OnTrafficUpdate(m.uploadTotal.Load(), m.downloadTotal.Load(), up, down)
+					m.lastPushedUpSpeed.Store(up)
+					m.lastPushedDownSpeed.Store(down)
+				}
+			}
 			if up != 0 || down != 0 {
 				timer.Reset(interval)
 				continue
