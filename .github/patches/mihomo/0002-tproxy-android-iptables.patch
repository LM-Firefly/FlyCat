+	// Exclude the root core's own egress (uid 0): its upstream connections must not be TPROXY'd back
+	// into itself or it loops. The routing-mark RETURN above is unreliable under the cmfa build (the
+	// dialer ignores the mark there), so match the uid explicitly.
+	execCmd("iptables -t mangle -A mihomo_output -m owner --uid-owner 0 -j RETURN")
+	for _, uid := range excludeUID {
+		execCmd(fmt.Sprintf("iptables -t mangle -A mihomo_output -m owner --uid-owner %d -j RETURN", uid))
+	}
+	if len(includeUID) > 0 {
+		// Whitelist: only the selected app uids are marked (proxied); everything else returns (direct).
+		for _, uid := range includeUID {
+			execCmd(fmt.Sprintf("iptables -t mangle -A mihomo_output -m owner --uid-owner %d -p tcp -j MARK --set-mark %s", uid, PROXY_FWMARK))
+			execCmd(fmt.Sprintf("iptables -t mangle -A mihomo_output -m owner --uid-owner %d -p udp -j MARK --set-mark %s", uid, PROXY_FWMARK))
+		}
+		execCmd("iptables -t mangle -A mihomo_output -j RETURN")
+	} else {
+		execCmd(fmt.Sprintf("iptables -t mangle -A mihomo_output -p tcp -j MARK --set-mark %s", PROXY_FWMARK))
+		execCmd(fmt.Sprintf("iptables -t mangle -A mihomo_output -p udp -j MARK --set-mark %s", PROXY_FWMARK))
+	}
+	// Hook ALL locally-generated output, not just `-o interfaceName` (which defaults to "lo"): on
+	// Android the apps we proxy egress via wlan0/rmnet, so an `-o lo` hook never sees their traffic
